APP_NAME=YakuAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
FRONTEND_URL=http://localhost:8081
APP_LOCALE=es
APP_TIMEZONE=America/Lima
APP_UID=1000
APP_GID=1000
API_PORT=8082
FRONTEND_PORT=8081
FRONTEND_BIND=127.0.0.1
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=yakuai
DB_USERNAME=yakuai
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# SMTP Brevo: usar el login SMTP y la clave SMTP (no una API key).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=YakuAI
OWM_KEY=
OWM_TIMEOUT=15
YAKUAI_MODE=demo


# Orígenes adicionales autorizados por CORS; en producción usar el dominio HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proveedor WhatsApp (opcional).
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=

# Solo para el seeder de la cuenta técnica inicial.
# Optional local technician seed; do not reuse weak passwords in production.
YAKUAI_TECHNICIAN_EMAIL=
YAKUAI_TECHNICIAN_PASSWORD=

